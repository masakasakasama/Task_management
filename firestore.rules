rules_version = '2';

// task-management-5c55f: only our two Google accounts may read or write.
// Deploy: Firebase Console > Firestore > Rules (or `firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {
    function isCouple() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'masakasakasama.man@gmail.com',
          'rere.geier@gmail.com'
        ];
    }

    match /spaces/{spaceId} {
      allow read, write: if isCouple();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
